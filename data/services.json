  "sections": [
    {
      "id": "start",
      "label": "Start here",
      "note": "Every engagement opens with one of these. Nothing else gets quoted until the business has actually been looked at."
    },
    {
      "id": "words",
      "label": "Words & content",
      "note": "Written by a person, researched against primary sources, Australian English. No bulk AI volume."
    },
    {
      "id": "social",
      "label": "Social & publishing",
      "note": "Runs on the NRS console. Managed for you, or licence the desk and run it yourself."
    },
    {
      "id": "search",
      "label": "Search — Google and AI",
      "note": "Two jobs now: ranking in Google, and being findable by ChatGPT, Claude and Perplexity."
    },
    {
      "id": "web",
      "label": "Web & build",
      "note": "Built by the people who ran it. Downscale is the reference — a live clinic, not a portfolio piece."
    },
    {
      "id": "automation",
      "label": "Automation & integrations",
      "note": "Only after the process has been looked at. Automating a broken process makes it break faster."
    },
    {
      "id": "brand",
      "label": "Brand & design"
    },
    {
      "id": "paid",
      "label": "Paid media",
      "note": "We will tell you if you are not ready to advertise — usually the site or follow-up is the problem, not the budget."
    },
    {
      "id": "compliance",
      "label": "Compliance, governance & safety",
      "note": "The part almost nobody else can deliver: a nurse practitioner who has built and operated compliant systems inside AHPRA-regulated businesses."
    },
    {
      "id": "care",
      "label": "Care plans",
      "note": "Ongoing. Cancel with 30 days notice, no lock-in contract."
    },
    {
      "id": "programmes",
      "label": "Full-scale programmes",
      "note": "Scoped and fixed-price before anything starts. The ones that change a business rather than improve a page."
    },
    {
      "id": "guides",
      "label": "Digital guides",
      "note": "Buy once, download immediately. Written from primary sources and dated — this area moves."
    }
  ],
